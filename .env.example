# Contesta: variables de entorno.
# Copiá este archivo como .env.local (o corré `npm run preparar`, que lo hace solo y
# genera las dos claves). Nunca subas .env.local a GitHub: ya está en .gitignore.

# ── Obligatorias ─────────────────────────────────────────────────────────────

# Clave única para entrar al panel. Elegí una larga y que no uses en otro lado.
CLAVE_PANEL=

# Secreto que usa el reloj para llamar a /api/cron cada minuto. Cualquier texto largo al azar.
CRON_SECRETO=

# ── Base de datos (Supabase) ─────────────────────────────────────────────────

# Cadena de conexión a tu Postgres de Supabase.
# En Supabase: botón "Connect" → "Transaction pooler" (puerto 6543). Reemplazá [YOUR-PASSWORD].
# Ejemplo: postgresql://postgres.abcdefgh:TU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Si la dejás vacía, en tu compu se usa una base local en la carpeta .datos (sirve para
# probar con el simulador sin crear ninguna cuenta). En Vercel es obligatoria.
DATABASE_URL=

# ── Instagram por Composio (opcional hasta que quieras conectar la cuenta) ───

# Tu clave de Composio: composio.dev → Settings → API Keys.
COMPOSIO_API_KEY=

# Dirección pública de tu panel, sin barra al final. Se usa para volver después de
# autorizar Instagram y para programar el reloj. Ejemplo: https://mi-contesta.vercel.app
URL_PUBLICA=

# Avanzado (no hace falta tocarlo):
# Versión del conjunto de herramientas de Instagram en Composio.
# COMPOSIO_TOOLKIT_VERSION_INSTAGRAM=20261112_00
# Poné 0 para apagar la respuesta privada a comentarios y los botones (usan la llamada
# directa de Composio a Instagram).
# COMPOSIO_PROXY=1
# Ruta de la API de mensajes de Instagram para esa llamada directa.
# COMPOSIO_IG_ENDPOINT_MENSAJES=/me/messages
# Si ya tenés una configuración de acceso de Instagram creada en Composio.
# COMPOSIO_AUTH_CONFIG_INSTAGRAM=

# ── Respuestas con IA (opcional) ─────────────────────────────────────────────

# Clave del Vercel AI Gateway: vercel.com → AI Gateway → API Keys.
# Sin esta clave el paso "Responder con IA" se saltea y todo lo demás funciona igual.
AI_GATEWAY_API_KEY=

# Modelo en formato proveedor/modelo.
# MODELO_IA=anthropic/claude-haiku-5.5
